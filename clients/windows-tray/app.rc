#include <windows.h>

#define IDD_IMPORT_LINK 200
#define IDC_LINK_EDIT   201

1 ICON "app.ico"
101 ICON "icons/disconnected.ico"
102 ICON "icons/connecting.ico"
103 ICON "icons/connected.ico"
104 ICON "icons/error.ico"
1 24 "app.manifest"

IDD_IMPORT_LINK DIALOGEX 0, 0, 250, 60
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Import vless:// link"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Paste a vless:// link:", -1, 10, 8, 230, 10
    EDITTEXT        IDC_LINK_EDIT, 10, 20, 230, 14, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    DEFPUSHBUTTON   "Import", IDOK, 140, 40, 48, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 192, 40, 48, 14
END
