#!/bin/sh
# Print a one-line pointer when the session runs a command.
#
# Interactive logins get the same notice from the MOTD. sshd runs this file
# before the shell owns the terminal, so a tty test on stdin is not reliable
# here. SSH_TTY is set only when a pty was allocated, and the MOTD covers that
# case.
[ -n "${SSH_TTY:-}" ] && exit 0
printf '%s\n' 'Read /etc/host-rules.md before you make any change.' >&2
exit 0
