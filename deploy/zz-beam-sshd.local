# SSH brute-force protection for the Beam host.
#
# Install with: apt-get install -y fail2ban
# Then copy this file to /etc/fail2ban/jail.d/zz-beam-sshd.local and run
# `systemctl enable --now fail2ban`.
#
# Keep the `zz-` prefix. Fail2ban reads jail.d in alphabetical order, and
# Debian ships defaults-debian.conf. A name that sorts before that file is
# overridden by the distribution defaults, including bantime and maxretry.
#
# The host allows public-key authentication only, so this jail bounds log noise
# and connection churn from scanners. It does not protect a password login,
# because the host offers none.
[DEFAULT]
backend = systemd
ignoreip = 127.0.0.1/8 ::1
# The ban time stays flat at one hour. A ladder would land on a shared
# carrier-grade NAT address: the neighbour of one offender inherits the
# escalation, and the owner's own key sits behind that address. A repeated
# offender returns once an hour, which a key-only port can absorb.
bantime = 1h
findtime = 10m
maxretry = 5
banaction = nftables-multiport

[sshd]
enabled = true
port = 22
