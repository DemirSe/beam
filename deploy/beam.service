[Unit]
Description=beam VLESS REALITY Vision server
After=network-online.target nss-lookup.target
Wants=network-online.target
# A crash must recover without an operator: Restart=always retries forever
# and the backoff below reaches one attempt per minute. This start limit stays
# as a hot-loop guard for manual restarts; the backoff keeps automatic starts
# from filling its window, so a broken unit is never left in start-limit-hit.
# The liveness timer still covers a hung process that systemd cannot see.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=beam
Group=beam
ExecStartPre=/usr/local/bin/beam --check -c /etc/beam/config.toml
ExecStart=/usr/local/bin/beam -c /etc/beam/config.toml
Restart=always
RestartSec=3s
# Backoff needs systemd 254 or later; Debian 13 and AlmaLinux 10 ship 257.
# The delay grows from 3 s to 60 s and stays there, so a persistent failure is
# retried once a minute instead of once every three seconds, and a fixed one
# recovers within about a minute without an operator.
RestartSteps=4
RestartMaxDelaySec=60s
TimeoutStartSec=15s
TimeoutStopSec=20s
# 1024 authenticated connections + up to 1024 XUDP reply tasks/threads + the
# blocking pool can exceed 512; memory and fd limits still bound damage.
TasksMax=4096
OOMPolicy=stop
RestrictRealtime=yes
LimitNOFILE=65536
MemoryHigh=512M
MemoryMax=768M
MemorySwapMax=512M
LimitCORE=0
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
