[Unit]
Description=beam VLESS REALITY Vision server
After=network-online.target nss-lookup.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=beam
Group=beam
ExecStartPre=/usr/local/bin/beam --check -c /etc/beam/config.toml
ExecStart=/usr/local/bin/beam -c /etc/beam/config.toml
Restart=on-failure
RestartSec=3s
TimeoutStartSec=15s
TimeoutStopSec=20s
# 1024 authenticated connections + up to 1024 XUDP reply tasks/threads + the
# blocking pool can exceed 512; memory and fd limits still bound damage.
TasksMax=4096
OOMPolicy=stop
RestrictRealtime=yes
LimitNOFILE=65536
MemoryHigh=512M
MemoryMax=768M
MemorySwapMax=512M
LimitCORE=0
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
